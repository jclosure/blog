		 /* height: 175px; */
		}

		#tiles .box:nth-child(4n-3) {
		/* padding-bottom: 30px; */
		}

		#tiles .box:nth-child(5n) {
		/* height: 250px; */
		}

		</style>

		<nav id="page-nav">
		  <a href="/home/page/2"></a>
		</nav>

		<div id="main" role="main">
			<div id="tiles">
				
				<%=h render_cell :photos, :display, :params => params %>

		    <!-- End of grid blocks -->
		 	</div>
		</div>


		<!-- Include the plug-in -->

		<%= javascript_include_tag "jquery.wookmark.js" %>
		<%= javascript_include_tag "jquery.waitforimages.js" %>
		

		  <!-- Once the page is loaded, initalize the plug-in. -->
		  <script type="text/javascript">
		    $(document).ready(new function() {
		      // Prepare layout options.
		      var options = {
		        autoResize: true, // This will auto-update the layout when the browser window is resized.
		        container: $('#main'), // Optional, used for some extra CSS styling
		        offset: 2, // Optional, the distance between grid items
		        itemWidth: 202 // Optional, the width of a grid item
		      };

		      // Get a reference to your grid items.
		      var handler = $('.box');

		      // Call the layout function.
		      handler.wookmark(options);

		      // Capture clicks on grid items.
		      handler.click(function(){
		        // Randomize the height of the clicked item.
		        $(this).css('height', Math.round(Math.random()*300+30)+'px');

		        // Update the layout.
		        handler.wookmark();
		      });

		    var $tiles = $('#tiles');

			  //infinite scroll setup
			$tiles.infinitescroll({
			      navSelector  : '#page-nav',    // selector for the paged navigation 
			      nextSelector : '#page-nav a',  // selector for the NEXT link (to page 2)
			      itemSelector : '.box',     // selector for all items you'll retrieve
			      animate      : true, 
			      bufferPx     : 1500,
			      extraScrollPx: 0
			      },
			      function( newElements ) {
			        // hide new items while they are loading
			        var $newElems = $( newElements ).css({ opacity: 0 });

					// show elems now they're ready
			         
			        $tiles.append($newElems.show());
			
					// $tiles.each(function(i, elem){
					// 															
					// 						$tile = $(elem);
					// 						$tile.waitForImages(function() {
					// 						  	$tile.css({ opacity: 1 });
					// 							$('.box').wookmark(options);
					// 						});
					// 					
					// 					});
					
					//$tiles.waitForImages(function() {
										
					//	$newElems.css({ opacity: 1 });
					//	$('.box').wookmark(options);
					//});
					 
					  
					$newElems.css({ opacity: 1 });
					$('.box').wookmark(options);
			 		  

			         
					// ensure that images load before adding to masonry layout
			        //$newElems.imagesLoaded(function(){});
			      }
			    );


		    });
		  </script>

	
	
		
		
	</div>
	
