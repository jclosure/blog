<!DOCTYPE html>
<html>
	<head>
		<title>
			NooLog
		</title><%= stylesheet_link_tag "application" %><%= javascript_include_tag "application" %><%= csrf_meta_tags %>
		<%= javascript_include_tag "jquery.masonry.min.js" %>
	</head>
	<body>
		

	
			
			<div id="header">
			 <!-- <%= image_tag("Vector_Banner_000145.jpg", :border=>0, :style => "float: left;") %> -->
			
			 
			 <div id="user_nav" style="padding-right: 20px; float: right;">
				<div style="float: right">
					<span><%= link_to "Log", "/" %></span>
					<span> | </span>
					<span><%= link_to "QR Generator", "/qr/index" %></span>
					<span> | </span>
					<span><%= link_to "DNS Trawler", "/dns/index" %></span>
					<span> | </span>
					<span><%= link_to "Blog", posts_path %></span>
					<span> | </span>
					<span><% if current_user %> Welcome <%= current_user.name %>! <%= link_to "Sign Out", signout_path %> <% else %> <%= link_to "Sign in with Twitter", "/auth/twitter" %> <% end %></span>
				</div>
			 </div>
			 <div style="clear: both"></div>
			</div>
			
			<div style="height: 10px"></div>	
				
		
			<div id="wrapper">
				
				<div id="social-container" style="float: right">
					<a href="https://twitter.com/jclosure" class="twitter-follow-button" data-show-count="false" data-size="large">Follow @jclosure</a> <script type="text/javascript">
!function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0];if(!d.getElementById(id)){js=d.createElement(s);js.id=id;js.src="//platform.twitter.com/widgets.js";fjs.parentNode.insertBefore(js,fjs);}}(document,"script","twitter-wjs");
					</script>
				</div>
				
				<div style="clear: both"></div>
				
					<div id="container" style="margin-left: 60px; margin-right: 60px; padding: 5px 5px 5px 5px; border: 1px solid #AAAAAA;">
						
						
						
						<div><%=h yield %></div>
					</div>
					<div id="sidebar">
						
					</div>
			</div>
	
	</body>
</html>
